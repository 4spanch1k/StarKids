# Copy to env/freedompay.local.env and fill locally.
# Do not commit env/freedompay.local.env.

FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_BASE_URL=https://api.freedompay.kz
FREEDOMPAY_RESULT_URL=http://localhost:8000/api/v1/public/payments/freedom/result
FREEDOMPAY_SUCCESS_URL=starkids://payments/success
FREEDOMPAY_FAILURE_URL=starkids://payments/failure
FREEDOMPAY_TESTING_MODE=true
FREEDOMPAY_MOCK_MODE=false
FREEDOMPAY_REQUEST_TIMEOUT_SECONDS=15
