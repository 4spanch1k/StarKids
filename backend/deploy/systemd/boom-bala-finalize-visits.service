[Unit]
Description=Boom Bala visit lifecycle finalizer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=boom-bala
Group=boom-bala
WorkingDirectory=/opt/boom-bala/backend
EnvironmentFile=/etc/boom-bala/staging.env
ExecStart=/opt/boom-bala/backend/.venv/bin/python scripts/finalize_visits.py
