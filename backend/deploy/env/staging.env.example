# Copy to /etc/boom-bala/staging.env and chmod 600.
# This file is a template only: replace every CHANGE_ME value outside git.

APP_ENV=staging
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://boom_bala:CHANGE_ME@127.0.0.1:5432/boom_bala_staging

# Required application secrets. Keep stable for the lifetime of this environment.
JWT_SECRET_KEY=CHANGE_ME
TICKET_QR_SECRET=CHANGE_ME

# Browser/admin origin only; do not use a wildcard in staging.
BACKEND_CORS_ORIGINS=https://ops-staging.boombala.kz

# FreedomPay sandbox only. Mock mode must remain disabled.
FREEDOMPAY_MERCHANT_ID=CHANGE_ME
FREEDOMPAY_SECRET_KEY=CHANGE_ME
FREEDOMPAY_BASE_URL=https://api.freedompay.kz
FREEDOMPAY_RESULT_URL=https://api-staging.boombala.kz/api/v1/public/payments/freedom/result
FREEDOMPAY_SUCCESS_URL=starkids://payments/success
FREEDOMPAY_FAILURE_URL=starkids://payments/failure
FREEDOMPAY_TESTING_MODE=true
FREEDOMPAY_MOCK_MODE=false

# OTP mock is never enabled in a deployed environment.
OTP_MOCK_MODE=false

# Local VPS media is allowed for the first staging deployment. Mount this path
# on persistent storage and back it up separately from the repository.
STORAGE_BACKEND=local
MEDIA_ROOT=/var/lib/boom-bala/media
MEDIA_URL_PREFIX=/media
PUBLIC_BASE_URL=https://api-staging.boombala.kz

# Optional push configuration. Leave disabled until all Firebase values exist.
PUSH_NOTIFICATIONS_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Automatic birthday reminders stay disabled until a real-device FCM proof and
# the business/legal rollout decision are complete. The worker remains safe to
# install and will be a no-op while this flag is false.
BIRTHDAY_REMINDERS_ENABLED=false
BIRTHDAY_REMINDER_WINDOWS=30,14,7

# Optional admin bootstrap. Prefer creating the operator explicitly and leave
# these empty after bootstrap; never use development defaults.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=Boom Bala Staging Admin
ADMIN_SEED_ROLE=super_admin

# Mobile privacy configuration must be set to real, reviewed URLs before release.
MOBILE_PRIVACY_POLICY_URL=CHANGE_ME
MOBILE_PRIVACY_CONSENT_VERSION=CHANGE_ME

# Distributed rate limiting is mandatory in staging and production.
# Use a protected URL; do not commit passwords or production credentials.
REDIS_URL=redis://127.0.0.1:6379/0
# Optional integration settings used only when the corresponding feature is enabled.
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=

# Backup script reads these values from the same protected environment file.
BACKUP_DIR=/var/backups/boom-bala/postgres
BACKUP_RETENTION_DAYS=14
